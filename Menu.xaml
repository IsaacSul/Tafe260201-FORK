<Page
    x:Class="Calculator.Menu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel>
            <Grid Background="Gray">
                <TextBlock Padding="12" FontWeight="Bold" FontSize="60" HorizontalAlignment="Center">Universal Calculator</TextBlock>
                <Image Source="/Assets/abacus.jpg" Width="160px" HorizontalAlignment="Right" ></Image>
            </Grid>

            <StackPanel Orientation="Vertical">
                <Button HorizontalAlignment="Center" Margin="4" FontSize="24" Click="mortgage_Click">Mortgage Calculator</Button>
                <Button HorizontalAlignment="Center" Margin="4" FontSize="24" Click="currency_Click">Currency Calculator</Button>
                <Button HorizontalAlignment="Center" Margin="4" FontSize="24" Click="math_Click">Math Calculator</Button>
                <Button HorizontalAlignment="Center" Margin="4" FontSize="24" Click="trip_Click">Trip Calculator</Button>
                <Button HorizontalAlignment="Center" Margin="4" FontSize="24">Exit</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>